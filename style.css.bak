/* By.Niadania — Editorial Beauty (refined) */
:root{
  --ivory:#f4efe8;--paper:#fbf8f3;--blush:#d9c4c7;--mist:#dce8f0;--lilac:#c9b8c8;--sage:#b8c8b7;
  --rosewood:#70565d;--ink:#27272a;--muted:#736a68;--line:rgba(39,39,42,.16);
  --serif:"Fraunces",Georgia,serif;--sans:"DM Sans",Arial,sans-serif;--radius:24px;--radius-lg:32px;
  --shadow:0 18px 50px rgba(39,39,42,.10);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:100px}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.7;overflow-x:hidden}
body.no-scroll{overflow:hidden}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
a,button{-webkit-tap-highlight-color:transparent}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:500;line-height:1.1;margin:0}
em{font-style:italic}
.section-wrap{width:min(1220px,calc(100% - 64px));margin-inline:auto}
.skip-link{position:fixed;left:12px;top:-60px;z-index:99;background:var(--ink);color:#fff;padding:10px 18px;border-radius:100px;transition:top .2s}
.skip-link:focus{top:12px}

/* Announcement */
.announcement{height:34px;padding:0 5.2%;background:var(--ink);color:#f8f1eb;display:flex;align-items:center;justify-content:space-between;font-size:10px;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;overflow:hidden}
.announcement span:last-child{text-align:right}

/* Header */
.site-header{height:88px;padding:0 5.2%;display:flex;align-items:center;gap:20px;border-bottom:1px solid var(--line);background:rgba(251,248,243,.94);position:sticky;top:0;z-index:20;backdrop-filter:blur(14px);transition:box-shadow .3s}
.site-header.scrolled{box-shadow:0 8px 30px rgba(39,39,42,.06)}
.brand,.footer-brand{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:24px;line-height:1;flex-shrink:0}
.brand img,.footer-brand img{width:44px;height:44px;object-fit:cover;border-radius:50%;mix-blend-mode:multiply}
.header-controls{margin-left:auto;display:flex;align-items:center;gap:14px}
.lang-switch{display:flex;border:1px solid var(--line);border-radius:100px;overflow:hidden}
.lang-btn{background:none;border:0;padding:7px 15px;font-size:10px;letter-spacing:.1em;color:var(--muted);transition:.2s}
.lang-btn.active{background:var(--rosewood);color:#fbf8f3}
.nav-links{display:flex;align-items:center;gap:26px;font-size:10px;letter-spacing:.1em;text-transform:uppercase}
.nav-links>a:not(.nav-cta){position:relative}
.nav-links>a:not(.nav-cta):after{content:"";position:absolute;bottom:-7px;left:0;width:0;height:1px;background:var(--rosewood);transition:width .3s}
.nav-links>a:hover:after{width:100%}
.nav-cta{border:1px solid var(--rosewood);padding:11px 18px;border-radius:100px;color:var(--rosewood);transition:.25s}
.nav-cta:hover{background:var(--rosewood);color:#fbf8f3}
.menu-toggle{display:none;background:none;border:0}

/* Buttons */
.button{display:inline-flex;align-items:center;gap:14px;min-height:50px;padding:14px 26px;border-radius:100px;border:1px solid transparent;font-size:11px;letter-spacing:.12em;text-transform:uppercase;transition:.25s}
.button-dark{background:var(--ink);color:#fbf8f3}
.button-dark:hover{background:var(--rosewood)}
.button-outline{border-color:var(--ink);color:var(--ink)}
.button-outline:hover{background:var(--ink);color:#fbf8f3}
.text-link{position:relative;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--rosewood);padding-bottom:3px}
.text-link:after{content:"";position:absolute;bottom:0;left:0;width:100%;height:1px;background:var(--rosewood);transform-origin:left;transition:transform .3s}
.text-link:hover:after{transform:scaleX(.4)}

/* Hero */
.hero{min-height:640px;padding-top:64px;padding-bottom:76px;display:grid;grid-template-columns:.9fr 1.1fr;gap:6%;align-items:center}
.hero-copy h1{font-size:clamp(46px,5.6vw,74px);letter-spacing:-.02em;margin-bottom:22px}
.hero-copy h1 em{color:var(--rosewood)}
.hero-description{font-size:15px;max-width:400px;margin:0 0 30px;color:var(--muted)}
.hero-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap}
.hero-note{margin-top:34px;display:flex;gap:26px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.hero-visual{padding-right:2%}
.hero-scene{position:relative;height:520px;perspective:900px}
.hero-image{position:absolute;inset:6% 8% 8%;background:linear-gradient(160deg,rgba(217,196,199,.35),rgba(201,184,200,.25)),url("https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1200&q=80") center/cover;border-radius:200px 200px 28px 28px;box-shadow:var(--shadow);will-change:transform;transition:transform .2s ease-out}
.hero-orb{position:absolute;border-radius:50%;filter:blur(.2px);will-change:transform;transition:transform .2s ease-out}
.orb-1{width:120px;height:120px;right:2%;top:6%;background:radial-gradient(circle at 30% 30%,#fff,var(--blush));opacity:.9}
.orb-2{width:70px;height:70px;left:0;top:38%;background:radial-gradient(circle at 30% 30%,#fff,var(--mist));opacity:.85}
.orb-3{width:52px;height:52px;right:14%;bottom:6%;background:radial-gradient(circle at 30% 30%,#fff,var(--sage));opacity:.8}

/* Intro */
.intro{padding:70px 0 75px}
.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:7%;align-items:start}
.intro h2{font-size:clamp(36px,4.4vw,58px);letter-spacing:-.02em}
.intro h2 em{color:var(--rosewood)}
.intro-text p{margin:0 0 22px;color:var(--muted)}

/* Section headings */
.section-heading{margin-bottom:44px}
.section-heading h2{font-size:clamp(34px,4vw,54px);letter-spacing:-.02em}
.section-heading h2 em{color:var(--rosewood)}

/* Services */
.service-grid{display:grid;grid-template-columns:1.1fr .9fr .9fr;gap:22px}
.service-card{border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;background:#fff;display:flex;flex-direction:column;transition:transform .3s,box-shadow .3s}
.service-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.service-photo{height:280px;position:relative}
.nails-photo{background:linear-gradient(150deg,rgba(232,213,212,.25),rgba(194,174,182,.3)),url("https://images.unsplash.com/photo-1632345031435-8727f6897d53?auto=format&fit=crop&w=900&q=80") center/cover}
.lash-photo{background:linear-gradient(150deg,rgba(227,233,238,.3),rgba(185,200,212,.3)),url("https://images.unsplash.com/photo-1600948836101-f9ffda59d250?auto=format&fit=crop&w=900&q=80") center/cover}
.makeup-photo{background:linear-gradient(150deg,rgba(236,226,217,.3),rgba(201,178,154,.3)),url("https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=900&q=80") center/cover}
.service-card-copy{padding:24px 26px 28px}
.service-card-copy h3{font-size:24px;margin-bottom:8px}
.service-card-copy p{margin:0;color:var(--muted);font-size:13px}

/* Gallery */
.gallery-section{padding:60px 0}
.filter-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:34px}
.filter{border:1px solid var(--line);background:#fff;border-radius:100px;padding:10px 20px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);transition:.2s}
.filter.active{background:var(--ink);color:#fbf8f3;border-color:var(--ink)}
.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:230px;gap:18px}
.gallery-tall{grid-row:span 2}
.gallery-wide{grid-column:span 2}
.gallery-item{position:relative;border:0;padding:0;border-radius:var(--radius);overflow:hidden;background:var(--ivory)}
.gallery-item img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.gallery-item:hover img{transform:scale(1.05)}
.gallery-label{position:absolute;left:14px;bottom:12px;background:rgba(251,248,243,.92);color:var(--ink);font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:7px 14px;border-radius:100px}
.gallery-item.is-hidden{display:none}
.gallery-note{margin-top:18px;font-size:12px;color:var(--muted);font-style:italic}

/* Prices */
.price-section{padding:70px 0;display:grid;grid-template-columns:.75fr 1.25fr;gap:6%;align-items:start}
.price-intro h2{font-size:clamp(34px,4vw,52px);letter-spacing:-.02em;margin-bottom:18px}
.price-intro h2 em{color:var(--rosewood)}
.price-intro p{color:var(--muted);margin:0 0 24px}
.price-list{border:1px solid var(--line);border-radius:var(--radius-lg);background:#fff;overflow:hidden}
.price-list-head{display:flex;justify-content:space-between;padding:18px 28px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--line)}
.price-row{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:17px 28px;border-bottom:1px solid var(--line)}
.price-row h3{font-size:17px;margin-bottom:3px}
.price-row p{margin:0;font-size:12px;color:var(--muted)}
.price-row strong{font-size:14px;white-space:nowrap}
.price-foot{padding:16px 28px;font-size:11px;color:var(--muted);font-style:italic;border-bottom:1px solid var(--line)}
.choose-nail{margin:20px 28px 26px}

/* Testimonial */
.testimonial-section{padding:70px 0;display:grid;grid-template-columns:.9fr 1.1fr;gap:7%;align-items:center}
.testimonial-image{height:400px;border-radius:200px 200px var(--radius-lg) var(--radius-lg);background:linear-gradient(150deg,rgba(220,232,240,.3),rgba(217,196,199,.3)),url("https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1000&q=80") center/cover;box-shadow:var(--shadow)}
.testimonial-copy h2{font-size:clamp(34px,4vw,52px);letter-spacing:-.02em;margin-bottom:16px}
.testimonial-copy h2 em{color:var(--rosewood)}
.testimonial-copy p{color:var(--muted);margin:0 0 26px}
.small-note{font-size:11px;color:var(--muted);font-style:italic;max-width:420px}

/* Booking */
.booking-section{position:relative;padding:90px 0;overflow:hidden}
.booking-backdrop{position:absolute;inset:0;background:linear-gradient(160deg,var(--ivory),var(--blush) 55%,var(--lilac));opacity:.5}
.booking-inner{position:relative;display:grid;grid-template-columns:.9fr 1.1fr;gap:6%;align-items:start}
.booking-heading h2{font-size:clamp(34px,4.2vw,56px);letter-spacing:-.02em;margin-bottom:18px}
.booking-heading h2 em{color:var(--rosewood)}
.booking-heading p{color:var(--muted);max-width:360px}
.booking-form{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:34px;display:grid;gap:18px;box-shadow:var(--shadow)}
.form-row{display:grid;gap:7px}
.form-row label{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);display:flex;justify-content:space-between;align-items:baseline}
.form-row label small{font-size:9px;color:var(--muted);letter-spacing:.08em}
.form-row input,.form-row select,.form-row textarea{border:1px solid var(--line);border-radius:14px;padding:12px 16px;background:var(--paper);font-size:14px;color:var(--ink);transition:border-color .2s}
.form-row input:focus,.form-row select:focus,.form-row textarea:focus{outline:none;border-color:var(--rosewood)}
.form-row textarea{resize:vertical;min-height:70px}
.field-error{display:none;font-size:11px;color:#a05151}
.field-error.visible{display:block}
input.invalid,select.invalid{border-color:#a05151}
.booking-consent{display:flex;gap:11px;align-items:flex-start}
.booking-consent input{margin-top:4px;accent-color:var(--rosewood)}
.booking-consent label{font-size:12px;color:var(--muted);line-height:1.6}
.booking-consent .field-error{flex-basis:100%}
.submit-button{justify-content:center}
.form-footnote{margin:0;font-size:11px;color:var(--muted);font-style:italic;text-align:center}

/* Booking options */
.booking-options{padding:70px 0;display:grid;grid-template-columns:1fr 1fr;gap:6%;align-items:center}
.booking-options h2{font-size:clamp(30px,3.4vw,44px);letter-spacing:-.02em;margin-bottom:14px}
.booking-options h2 em{color:var(--rosewood)}
.booking-options p{color:var(--muted);margin:0 0 20px}
.option-buttons{display:grid;gap:14px;justify-items:start}
.option-buttons .button{justify-self:start}

/* Footer */
.site-footer{border-top:1px solid var(--line);padding:60px 5.2% 34px;background:var(--ivory)}
.footer-top{display:flex;align-items:center;justify-content:space-between;gap:26px;flex-wrap:wrap;padding-bottom:38px;border-bottom:1px solid var(--line)}
.footer-top p{margin:0;color:var(--muted);font-family:var(--serif);font-size:18px;font-style:italic}
.footer-social{display:flex;gap:14px;padding:26px 0}
.social-btn{width:44px;height:44px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--ink);transition:.25s;background:#fff}
.social-btn:hover{background:var(--ink);color:#fbf8f3;border-color:var(--ink)}
.social-btn.coming-soon{opacity:.55}
.footer-bottom{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;font-size:11px;color:var(--muted);padding-top:8px}
.footer-legal{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-top:22px;padding-top:20px;border-top:1px solid var(--line)}
.footer-disclaimer{margin:0;font-size:11px;color:var(--muted);max-width:640px}
.footer-credit{margin:0;font-size:11px;color:var(--muted)}
.portoweb-link{color:var(--rosewood);border-bottom:1px solid currentColor;transition:.2s}
.portoweb-link:hover{color:var(--ink)}

/* Booking dialog */
.booking-dialog{width:min(560px,calc(100% - 28px));border:0;border-radius:var(--radius-lg);padding:34px;background:var(--paper);color:var(--ink);box-shadow:var(--shadow)}
.booking-dialog::backdrop{background:rgba(23,23,25,.55);backdrop-filter:blur(4px)}
.booking-dialog h2{font-size:clamp(26px,3vw,34px);margin-bottom:20px}
.booking-dialog h2 em{color:var(--rosewood)}
.summary-content{display:grid;gap:0;border:1px solid var(--line);border-radius:18px;overflow:hidden;margin-bottom:18px}
.summary-row{display:flex;justify-content:space-between;gap:18px;padding:12px 18px;border-bottom:1px solid var(--line);font-size:13px}
.summary-row:last-child{border-bottom:0}
.summary-row span:first-child{color:var(--muted)}
.summary-note{font-size:11px;color:var(--muted);font-style:italic;margin:0 0 20px}
.dialog-close{position:absolute;top:16px;right:16px;width:38px;height:38px;border:1px solid var(--line);border-radius:50%;background:#fff;cursor:pointer}
.dialog-close span{position:absolute;left:50%;top:50%;width:15px;height:1.5px;background:var(--ink);transform:translate(-50%,-50%) rotate(45deg)}
.dialog-close span:last-child{transform:translate(-50%,-50%) rotate(-45deg)}
.booking-dialog .button{justify-content:center;width:100%}
.dialog-edit{display:block;margin:14px auto 0}

/* Toast */
.toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);background:var(--ink);color:#fbf8f3;padding:13px 24px;border-radius:100px;font-size:12px;opacity:0;pointer-events:none;transition:.3s;z-index:60;max-width:calc(100% - 40px);text-align:center}
.toast.show{opacity:1;transform:translate(-50%,0)}

/* Reveal */
.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s ease}
.reveal.visible{opacity:1;transform:none}

/* Large screens */
@media(min-width:1400px){
  .hero{min-height:730px}
  .hero-scene{height:580px}
  .service-photo{height:320px}
}

/* Tablet */
@media(max-width:1020px){
  .service-grid{grid-template-columns:1fr 1fr}
  .service-main{grid-column:span 2}
  .gallery-grid{grid-template-columns:repeat(2,1fr);grid-auto-rows:240px}
}

/* Mobile */
@media(max-width:900px){
  .section-wrap{width:min(100% - 40px,720px)}
  .site-header{height:74px;padding:0 22px}
  .nav-links{position:absolute;top:74px;left:0;right:0;background:var(--paper);padding:24px 22px 28px;flex-direction:column;align-items:stretch;gap:18px;border-bottom:1px solid var(--line);box-shadow:0 20px 30px rgba(39,39,42,.08);display:none}
  .nav-links.open{display:flex}
  .nav-links>a{padding:5px 0}
  .nav-links .nav-cta{text-align:center;justify-content:center;padding:14px}
  .menu-toggle{display:flex;width:40px;height:40px;flex-direction:column;align-items:center;justify-content:center;gap:6px;border:1px solid var(--line);border-radius:50%;background:#fff}
  .menu-toggle span{height:1px;width:16px;background:var(--ink);transition:transform .2s}
  .menu-toggle[aria-expanded=true] span:first-child{transform:translateY(3.5px) rotate(45deg)}
  .menu-toggle[aria-expanded=true] span:last-child{transform:translateY(-3.5px) rotate(-45deg)}
  .hero{display:flex;flex-direction:column;align-items:stretch;min-height:auto;padding-top:40px;padding-bottom:56px;gap:30px}
  .hero-copy h1{font-size:clamp(44px,11vw,64px)}
  .hero-scene{height:min(112vw,440px)}
  .intro-grid,.booking-inner,.booking-options,.price-section,.testimonial-section{grid-template-columns:1fr;gap:30px}
  .intro,.price-section,.testimonial-section,.booking-options{padding:56px 0}
  .booking-section{padding:60px 0}
  .booking-form{padding:26px 22px}
  .gallery-grid{grid-template-columns:repeat(2,1fr);grid-auto-rows:200px;gap:14px}
  .gallery-tall{grid-row:span 2}
  .service-grid{grid-template-columns:1fr}
  .service-main{grid-column:auto}
  .service-photo{height:250px}
  .price-row{padding:14px 20px}
  .price-list-head{padding:15px 20px}
  .price-foot{padding:14px 20px}
  .choose-nail{margin:18px 20px 22px}
  .footer-top{flex-direction:column;align-items:flex-start}
}

/* Small phones */
@media(max-width:420px){
  body{font-size:14px}
  .announcement{font-size:8px;letter-spacing:.08em;padding:0 14px;gap:8px}
  .announcement span:last-child{white-space:nowrap}
  .site-header{height:68px;padding:0 16px}
  .brand{font-size:21px}
  .brand img{width:38px;height:38px}
  .nav-links{top:68px}
  .lang-btn{padding:6px 11px;font-size:9px}
  .hero-copy h1{font-size:clamp(40px,12.5vw,54px)}
  .hero-description{font-size:13px}
  .hero-note{flex-direction:column;gap:8px;font-size:9px}
  .hero-actions{gap:16px}
  .button{min-height:46px;padding:12px 18px;font-size:10px}
  .gallery-grid{grid-auto-rows:180px}
  .booking-form{padding:22px 16px}
  .booking-dialog{padding:26px 20px}
  .footer-bottom{flex-direction:column;gap:6px}
  .footer-legal{flex-direction:column;gap:8px}
}

/* Reduced motion */
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  .reveal{opacity:1;transform:none}
}
